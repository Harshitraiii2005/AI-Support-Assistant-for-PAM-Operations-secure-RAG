# Copy to .env (git-ignored) and fill in. Generate each secret with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
OPERATOR_TOKEN=
ADMIN_TOKEN=
QDRANT_API_KEY=

CHAT_MODEL=qwen2.5:7b-instruct
EMBED_MODEL=nomic-embed-text

# Linux / GPU host: run Ollama inside compose (default)
COMPOSE_PROFILES=bundled-ollama
OLLAMA_URL=http://ollama:11434

# macOS: Docker has no Metal GPU access, so run `ollama serve` natively and use instead:
# COMPOSE_PROFILES=
# OLLAMA_URL=http://host.docker.internal:11434
